
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "rawsie-dev",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2026-11-25",
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
    },
    "observability": {
        "enabled": true
    }
}
